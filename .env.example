# ── Provider selection ───────────────────────────────────────────────────────
# Analysis provider: "gemini" (default), "claude", or "ollama" (local/free).
PROVIDER=gemini

# ── Provider key (only the selected provider's key is needed) ─────────────────
# Gemini key — https://aistudio.google.com/apikey   (GOOGLE_API_KEY also accepted)
GEMINI_API_KEY=AQ...
# Anthropic key — https://console.anthropic.com/settings/keys (only if PROVIDER=claude)
# ANTHROPIC_API_KEY=sk-ant-...
# Ollama needs no key — just `ollama serve` running locally:
OLLAMA_HOST=http://localhost:11434

# ── Local testing without spending tokens or sending email ───────────────────
# Set PROVIDER=ollama (free local model) and DRY_RUN=true to run the full
# pipeline and write digest_YYYYMMDD.html WITHOUT calling a paid API or Resend.
# In DRY_RUN, RESEND_API_KEY is not required.
DRY_RUN=false

# ── Email delivery (required unless DRY_RUN=true) ────────────────────────────
# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=re...

# ── Email settings ───────────────────────────────────────────────────────────
EMAIL_TO=youremail@gmail.com
# The default test sender (onboarding@resend.dev) can ONLY send to the email of
# the Resend account owner. To send anywhere else, verify a domain in Resend and
# use e.g. "AI Digest <digest@yourdomain.com>".
EMAIL_FROM=AI Daily Digest <onboarding@resend.dev>

# ── Tuning (optional — sensible defaults baked in) ───────────────────────────
# Model. Leave blank to use the provider default:
#   gemini -> gemini-2.5-flash   |   claude -> claude-sonnet-4-6   |   ollama -> llama3.1
# Examples: gemini-2.5-pro, claude-opus-4-8, qwen2.5, llama3.2
DIGEST_MODEL=

# Two-pass quality/cost split: optional STRONGER model that re-synthesizes just
# the Opportunity sections (the product) while DIGEST_MODEL does the cheap bulk
# summarization. Leave blank for a single pass (exactly the old behavior).
# Example: DIGEST_MODEL=gemini-2.5-flash-lite + OPPORTUNITY_MODEL=gemini-2.5-pro
OPPORTUNITY_MODEL=

# Self-memory: feed recent Opportunity titles from docs/receipts.md into the
# prompt so the agent never re-pitches an idea it already proposed. Needs
# PUBLISH_ARCHIVE=true (that's what writes receipts.md). Fail-open.
OPPORTUNITY_MEMORY=true
OPPORTUNITY_MEMORY_DAYS=60

# Field preset: retarget the whole briefing to another field with one var.
# ai (default) | security | biotech | fintech — or add your own in src/presets/.
SOURCE_PRESET=ai

# How many days back to consider as "latest". 7 recommended so weekend gaps
# (arXiv doesn't publish Sat/Sun) don't leave the research section empty.
LOOKBACK_DAYS=7

# Web grounding: Gemini -> Google Search, Claude -> web_search tool.
# Set to "false" to run purely from RSS + arXiv (cheaper, less coverage).
ENABLE_WEB_SEARCH=true

# Max arXiv papers to pull per query before ranking.
ARXIV_MAX_RESULTS=40

# Image-rich "Top Stories" hero — the day's top 3–4 stories with article
# thumbnails + a short summary, rendered at the very top (TechPresso / The Neuron
# style). The synthesis prompt is told which items are featured so The Pulse
# doesn't repeat them. On by default.
ENABLE_TOP_STORIES=true
TOP_STORIES_COUNT=5

# Paid section "The Builder's Edge": 3–5 buildable bets, each prior-art-checked
# and grounded in the last 3–6 months of research. Goes to your email + Buttondown
# subscribers; ALWAYS stripped from the public archive. Set true to activate the
# bundled section (src/private/builders_edge.py), or copy that file to
# src/private/opportunity.py for a truly-private, customized version.
ENABLE_BUILDERS_EDGE=false

# Write the rendered HTML to disk too (useful for CI artifacts / debugging).
SAVE_HTML=true

# Cross-day dedup: drop items already covered by a previous digest, tracked in
# <ARCHIVE_DIR>/.state/seen_items.json (pruned after LOOKBACK_DAYS * 2 days).
# Fail-open: a missing/corrupt state file just means nothing is filtered.
CROSS_DAY_DEDUP=true

# HEAD-check every link in the digest before sending/publishing; dead links are
# flagged visibly and logged. Fail-open: network trouble never aborts the run.
ENABLE_LINK_CHECK=true

# Show a "powered by <provider> (<model>)" line in the email footer.
# Off by default for a clean footer; set true if you want the attribution.
SHOW_MODEL_ATTRIBUTION=false

# Show a private "📊 Your dAIly list" subscriber-count card in YOUR OWN email
# copy (never sent to subscribers). Off by default so no count appears in the
# email at all. To see subscribers privately, run `python -m scripts.subscribers`
# locally, or use the Resend dashboard → Audience → Contacts.
LIST_REPORT_IN_EMAIL=false

# One-click feedback widget target (😍 🙂 😕). A URL gets ?r=loved|ok|meh
# appended; blank → a mailto to FEEDBACK_EMAIL (below).
# FEEDBACK_URL=https://forms.gle/yourform

# Where reader feedback (the 😍 🙂 😕 mailto) and plain replies are delivered.
# Both default to EMAIL_TO so the aigenos owner always receives them; set these
# to route to a dedicated address (e.g. hello@aigenos.dev).
# FEEDBACK_EMAIL=
# REPLY_TO=

# Unsubscribe link for the email footer — REQUIRED before sending to anyone but
# yourself. Either a URL or your sending platform's merge tag, e.g. Resend:
# UNSUBSCRIBE_URL={{{RESEND_UNSUBSCRIBE_URL}}}
# or Buttondown: UNSUBSCRIBE_URL={{ unsubscribe_url }}
UNSUBSCRIBE_URL=

# ── Public archive (GitHub Pages) ────────────────────────────────────────────
# Publish each day's digest to <ARCHIVE_DIR>/ as a browsable site. PRIVATE
# sections (e.g. the Opportunity Map) are automatically stripped before publish.
PUBLISH_ARCHIVE=false
ARCHIVE_DIR=docs
SITE_TITLE=aigenos — Daily AI Digest
# Public base URL of your Pages site (used to link the full issue in chat posts):
# SITE_URL=https://YOURUSER.github.io/aigenos
# Hero masthead logo (light + dark variants). Default to
# <SITE_URL>/assets/aigenos-logo-light.png and -dark.png (committed). Override
# with LOGO_URL / LOGO_URL_DARK, or leave SITE_URL unset for the 🤖 emoji.
# LOGO_URL=https://yourdomain.com/logo-light.png
# LOGO_URL_DARK=https://yourdomain.com/logo-dark.png
# Hero masthead: a baked image (logo + title + tagline) used as the hero so
# no mail client can recolor/invert it. Defaults to
# <SITE_URL>/assets/hero-masthead.png (committed). Override with HERO_IMAGE_URL.
# HERO_IMAGE_URL=https://yourdomain.com/hero.png
# ── Subscriptions (one variable wires everything) ────────────────────────────
# Set SUBSCRIBE_HANDLE to your Buttondown username and the subscribe URL, the
# on-page signup form, and the unsubscribe merge tag are all derived — so the
# landing page, README button, newsletter footer, and subscriber delivery work
# together. Create a free account at https://buttondown.com (≤100 subs free).
# SUBSCRIBE_HANDLE=your-buttondown-username
#
# Then add BUTTONDOWN_API_KEY (below) to actually SEND each issue to subscribers.
# Non-Buttondown setups can still set these explicitly (they override the handle):
# SUBSCRIBE_URL=
# SUBSCRIBE_FORM_ACTION=
# UNSUBSCRIBE_URL=

# ── Audio episode / podcast mode (free, no key — uses gTTS) ──────────────────
# Voices the day's core (In Brief + The Pulse + Opportunity) to an MP3. With
# PUBLISH_ARCHIVE=true the episode lands in <ARCHIVE_DIR>/audio/ so GitHub
# Pages hosts it: the email gets a ▶️ Listen button, the archive page an inline
# player, and <SITE_URL>/podcast.xml is a podcast-app-subscribable RSS feed.
# Without archiving, the MP3 just goes to AUDIO_DIR. Fail-open everywhere.
ENABLE_AUDIO=true
AUDIO_DIR=out

# ── Subscriber delivery via Resend Broadcasts (recommended, self-configuring) ─
# Subscribers get the SAME styled HTML the owner gets. ONE manual step: verify
# your domain at resend.com → Domains. Everything else resolves at run time —
# sender (daily@<verified-domain>), audience (first one, or auto-created
# "dAIly subscribers"), Buttondown list auto-migration, and Resend's managed
# one-click unsubscribe. These vars are OPTIONAL overrides only:
# RESEND_AUDIENCE_ID=          # pin a specific audience
# (EMAIL_FROM above pins the sender address)

# ── Subscriber delivery via Buttondown (legacy alternative) ──────────────────
# Buttondown sanitizes/reflows HTML, so subscribers can see a slightly different
# layout than your Resend copy. Prefer Resend Broadcasts above for parity.
# Leave BUTTONDOWN_API_KEY unset when using Resend.
# Key: https://buttondown.com/settings → API
# BUTTONDOWN_API_KEY=
# What subscribers receive:
#   "html"   (default) — the FULL styled email, identical to your own copy
#            (hero, aigenos logo + title, Top Stories cards, all the styling).
#   "teaser" — The Pulse + Opportunity as Markdown + a link to the full issue.
#   "full"   — the entire public issue converted to Markdown.
BUTTONDOWN_MODE=html

# ── Multi-channel delivery (all optional; blank = disabled) ───────────────────
# Posts a short text teaser (The Pulse + link to the full issue) to each channel.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_CHAT_ID=123456789
